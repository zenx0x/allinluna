{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "direct-work-result/v1",
  "title": "External Direct Work Result",
  "description": "A report of work that requires independent runtime verification.",
  "type": "object",
  "required": [
    "protocol",
    "result_digest",
    "plan_digest",
    "work_unit_id",
    "attempt_id",
    "idempotency_key"
  ],
  "properties": {
    "protocol": {"const": "direct-work-result/v1"},
    "result_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "plan_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "work_unit_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["completed", "blocked", "failed", "in_progress"]},
    "summary": {"type": "string"},
    "changed_paths": {"type": "array", "items": {"type": "string"}},
    "raw_outputs": {"type": "array"},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "exports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "artifact_ref"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "artifact_ref": {"type": "string", "minLength": 1},
          "version": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": true
      }
    },
    "blockers": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}
