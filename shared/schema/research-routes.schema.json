{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allinluna.local/schemas/research-routes.schema.json",
  "title": "Research Routes semantic context",
  "type": "object",
  "required": ["id", "title", "kind", "starting_point", "nodes", "routes", "human_decisions"],
  "properties": {
    "id": {"type": "string", "pattern": "^ctx-"},
    "title": {"type": "string", "minLength": 1},
    "kind": {"enum": ["software", "research-exploration", "hybrid"]},
    "starting_point": {"type": "string", "minLength": 1},
    "nodes": {"type": "object"},
    "routes": {"type": "object"},
    "human_decisions": {"type": "object"},
    "current_continuation_id": {"type": ["string", "null"]},
    "canonical_node_ids": {"type": "array", "items": {"type": "string"}},
    "lifecycle_events": {"type": "array"}
  },
  "$defs": {
    "nodeKinds": {"enum": ["question", "problem", "frame", "shared-backbone", "route", "branch", "claim", "hypothesis", "probe", "experiment", "evidence", "observation", "unknown", "decision", "implementation", "canonical", "continuation", "provenance", "counterpilot"]},
    "evidencePolarity": {"enum": ["support", "counter", "null", "boundary", "conflict", "failure", "context", "mixed", "unknown"]},
    "relation": {"enum": ["source-stated", "deterministic-derived", "candidate-inferred", "human-confirmed"]},
    "lifecycle": {"enum": ["Create", "Fork", "Park", "Reopen", "Revive", "Rewind", "Reject", "Supersede", "Historical Context", "Unresolved"]}
  }
}
