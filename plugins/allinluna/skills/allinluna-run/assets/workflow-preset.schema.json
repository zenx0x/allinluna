{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zenx0x/allinluna/schemas/workflow-preset.schema.json",
  "title": "All in Luna Scoped Workflow Presets",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "user": {"$ref": "#/$defs/preset"},
    "repository": {"$ref": "#/$defs/preset"},
    "research-project": {"$ref": "#/$defs/preset"},
    "run": {"$ref": "#/$defs/preset"}
  },
  "$defs": {
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {"type": "string"},
        "concurrency": {"type": ["integer", "object"]},
        "resource_policy": {"type": "object"},
        "capability_bindings": {"type": "array"},
        "resources": {"type": "object"},
        "permissions": {"type": "object"},
        "provenance": {"type": "object"}
      }
    }
  }
}
