        "required": ["target", "prompt", "model", "title"],
        "properties": {
          "target": {"type": "object"},
          "prompt": {"type": "string"},
          "model": {"type": "string"},
          "thinking": {"type": ["string", "null"]},
          "title": {"type": "string"}
        }
      },
      "receipt": {"required_any": ["threadId", "clientThreadId"], "host_id": "hostId"}
    },
    "codex_app__list_projects": {
      "available": true,
      "parameters": {
        "type": "object",
