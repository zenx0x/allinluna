{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zenx0x/allinluna/schemas/development-plan.schema.json",
  "title": "All in Luna Development Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "title",
    "mode",
    "objective",
    "execution_style",
    "risk_level",
    "completion_standard",
    "stop_boundary",
    "repository",
    "authorizations",
    "orchestration",
    "resource_policy",
    "tasks",
    "milestones",
    "assumptions",
    "unknowns"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "plan_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$" },
    "title": { "type": "string", "minLength": 3 },
    "mode": { "enum": ["plan-only", "execute-ready", "goal-ready"] },
    "objective": { "type": "string", "minLength": 10 },
    "execution_style": { "enum": ["managed", "parallel-only"] },
    "risk_level": { "enum": ["low", "medium", "high", "critical"] },
    "completion_standard": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "stop_boundary": { "type": ["string", "null"] },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "roots", "instructions", "protected_paths"],
      "properties": {
        "mode": { "enum": ["existing", "greenfield", "multi-repository"] },
        "roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "git", "branch", "head", "dirty_state"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "git": { "type": "boolean" },
              "branch": { "type": ["string", "null"] },
              "head": { "type": ["string", "null"] },
              "dirty_state": { "enum": ["clean", "dirty", "not-git", "unknown"] }
            }
          }
        },
        "instructions": { "type": "array", "items": { "type": "string" } },
        "protected_paths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "authorizations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_writes",
        "git_operations",
        "goal_creation",
        "top_level_tasks",
        "top_level_tasks_basis",
        "destructive_operations",
        "live_external_mutation",
        "publication"
      ],
      "properties": {
        "implementation_writes": { "type": "boolean" },
        "git_operations": { "type": "boolean" },
        "goal_creation": { "type": "boolean" },
        "top_level_tasks": { "const": true },
        "top_level_tasks_basis": {
          "const": "allinluna-default"
        },
        "destructive_operations": { "type": "boolean" },
        "live_external_mutation": { "type": "boolean" },
        "publication": { "type": "boolean" }
      }
    },
    "orchestration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sponsor_role",
        "coordinator_role",
        "coordinator_product_implementation",
        "owner_delegation",
        "owner_subagents",
        "counterpilot",
        "coordination_strategy",
        "shard_size",
        "high_concurrency_review",
        "decomposition_model"
      ],
      "properties": {
        "sponsor_role": { "const": "user-conversation" },
        "coordinator_role": { "const": "separate-top-level-task" },
        "coordinator_product_implementation": { "const": "forbidden" },
        "owner_delegation": { "const": "top-level-task" },
        "owner_subagents": { "const": "allowed-bounded" },
        "counterpilot": { "enum": ["off", "auto", "risk-triggered", "milestone", "continuous"] },
        "counterpilot_risk_waiver": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["acknowledged", "reason"],
          "properties": {
            "acknowledged": { "const": true },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "coordination_strategy": { "enum": ["auto", "flat", "hierarchical"] },
        "shard_size": { "type": "integer", "minimum": 2, "maximum": 12 },
        "high_concurrency_review": { "enum": ["not-required", "accepted", "declined"] },
        "decomposition_model": { "type": ["string", "null"] }
      }
    },
    "resource_policy": { "$ref": "#/$defs/resourcePolicy" },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    },
    "milestones": {
      "type": "array",
      "items": { "$ref": "#/$defs/milestone" }
    },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "topology": { "$ref": "#/$defs/topology" },
    "acceptance": { "$ref": "#/$defs/acceptancePolicy" },
    "workflow_preset": { "type": "object" }
  },
  "$defs": {
    "resourcePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "modifiers",
        "hard_model_lock",
        "unavailable_action",
        "fallback_models",
        "concurrency",
        "budget",
        "role_overrides"
      ],
      "properties": {
        "profile": {
          "enum": ["premium", "balanced", "economy", "speed", "fast", "ultra-fast", "all-luna", "mad-luna", "custom"]
        },
        "modifiers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["speed", "fast", "ultra-fast"] }
        },
        "hard_model_lock": { "type": ["string", "null"] },
        "unavailable_action": { "enum": ["pause", "ask", "fallback-list"] },
        "fallback_models": { "type": "array", "items": { "type": "string" } },
        "concurrency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["desired", "host_cap_behavior"],
          "properties": {
            "desired": { "type": "integer", "minimum": 1, "maximum": 64 },
            "host_cap_behavior": { "const": "cap-at-runtime" }
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metric", "soft_limit", "hard_limit"],
          "properties": {
            "metric": { "enum": ["none", "tokens", "credits", "time-minutes", "currency", "custom"] },
            "soft_limit": { "type": ["number", "null"], "minimum": 0 },
            "hard_limit": { "type": ["number", "null"], "minimum": 0 }
          }
        },
        "role_overrides": { "type": "object" }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": { "const": "risk-adaptive" },
        "size": { "enum": ["small", "medium", "large"] },
        "signals": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "shared_contract": { "type": "boolean" },
            "scientific_safety": { "type": "boolean" },
            "external_write": { "type": "boolean" }
          }
        },
        "shared_contract": { "type": "boolean" },
        "scientific_safety": { "type": "boolean" },
        "external_write": { "type": "boolean" },
        "integration": { "enum": ["auto", "none", "required"] },
        "independent_acceptance": { "enum": ["auto", "none", "required"] }
      }
    },
    "acceptancePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifest_id": { "type": "string", "minLength": 1 },
        "read_only": { "const": true },
        "reasoning": { "enum": ["auto", "high", "xhigh"] },
        "time_budget_minutes": { "type": "integer", "minimum": 1 }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "phase",
        "description",
        "dependencies",
        "ownership",
        "role",
        "resource_class",
        "deliverables",
        "verification",
        "validation_level",
        "external_side_effects",
        "acceptance_required",
        "capability_bindings",
        "full_read_requirements"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "title": { "type": "string", "minLength": 3 },
        "phase": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 10 },
        "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "ownership": {
          "type": "object",
          "additionalProperties": false,
          "required": ["paths", "non_file_scope", "exclusive"],
          "properties": {
            "paths": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "non_file_scope": { "type": ["string", "null"] },
            "exclusive": { "type": "boolean" }
          }
        },
        "role": { "type": "string", "minLength": 1 },
        "resource_class": {
          "enum": ["authority", "architecture", "implementation-complex", "implementation-clear", "mechanical", "integration", "acceptance"]
        },
        "deliverables": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
        "verification": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
        "validation_level": { "enum": ["focused", "cross-lane", "milestone", "full"] },
        "external_side_effects": { "type": "array", "items": { "type": "string" } },
      "acceptance_required": { "type": "boolean" },
      "capability_bindings": { "type": "array", "items": { "type": "object" } },
      "full_read_requirements": { "type": "array", "items": { "type": "string" } }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "task_ids", "integration_evidence", "acceptance_evidence", "unlocks"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 3 },
        "task_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "integration_evidence": { "type": "array", "items": { "type": "string" } },
        "acceptance_evidence": { "type": "array", "items": { "type": "string" } },
        "unlocks": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    }
  }
}
