        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "receipt": {"required": ["threads", "cursor"]}
    },
    "codex_app__read_thread": {
      "available": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["threadId"],
        "properties": {
          "threadId": {"type": "string"},
          "hostId": {"type": "string"},
          "cursor": {"type": "string"}
        }
      },
      "receipt": {"required": ["threadId", "status"]}
    },
    "codex_app__send_message_to_thread": {
      "available": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["threadId", "prompt"],
        "properties": {
          "threadId": {"type": "string"},
          "hostId": {"type": "string"},
          "prompt": {"type": "string"}
        }
      },
      "receipt": {"required": ["threadId", "messageId"]}
    },
    "codex_app__wait_threads": {
      "available": false,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["targets"],
        "properties": {
          "targets": {"type": "array", "items": {"type": "object"}}
        }
      },
      "receipt": {"required": ["targets", "status"]}
    }
  },
  "fallbacks": {
    "wait_threads": {
      "requested": "codex_app__wait_threads",
      "resolved": ["codex_app__list_threads", "codex_app__read_thread"],
      "actual": "poll-top-level-tasks",
      "fallback": "wait-tool-not-declared-by-host-capability-receipt"
    },
    "missing_monitoring_receipt": {
      "requested": ["codex_app__wait_threads", "codex_app__list_threads", "codex_app__read_thread"],
      "resolved": null,
      "actual": "discover-thread-monitoring-tools",
      "fallback": "fail-closed-until-host-capability-is-discovered"
    }
  },
