{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zenx0x/allinluna/schemas/v1/work-unit-envelope.schema.json",
  "title": "All in Luna vNext WorkUnitEnvelope",
  "description": "Lane to WorkUnit recursive dispatch envelope using base context plus delta.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "protocol",
    "message_id",
    "run_ref",
    "task_ref",
    "work_unit_id",
    "parent_work_unit_ref",
    "objective",
    "base_context_ref",
    "context_delta",
    "scope",
    "authority",
    "ownership",
    "checks",
    "return_contract",
    "idempotency_key",
    "created_at"
  ],
  "properties": {
    "kind": {"const": "work-unit-envelope"},
    "schema_version": {"const": "1.0"},
    "protocol": {"const": "work-unit-envelope/v1"},
    "message_id": {"$ref": "#/$defs/identifier"},
    "run_ref": {"$ref": "#/$defs/run_ref"},
    "task_ref": {"$ref": "#/$defs/task_ref"},
    "work_unit_id": {"$ref": "#/$defs/identifier"},
    "parent_work_unit_ref": {
      "anyOf": [{"$ref": "#/$defs/work_unit_ref"}, {"type": "null"}]
    },
    "objective": {"type": "string", "minLength": 1, "maxLength": 12000},
    "base_context_ref": {"$ref": "#/$defs/context_ref"},
    "context_delta": {"$ref": "#/$defs/context_delta"},
    "scope": {"$ref": "#/$defs/scope"},
    "authority": {"$ref": "#/$defs/authority"},
    "ownership": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/path"}
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/check"}
    },
    "return_contract": {"const": "work-handoff/v1"},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{8,256}$"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\.\\.)(?!.*//).+$"
    },
    "ref": {
      "type": "string",
      "pattern": "^(artifact|context|snapshot|decision|task|work-unit|contract|receipt)://[^\\s]+$"
    },
    "run_ref": {
      "type": "string",
      "pattern": "^run://[^\\s]+$"
    },
    "task_ref": {
      "type": "string",
      "pattern": "^task://[^\\s]+$"
    },
    "work_unit_ref": {
      "type": "string",
      "pattern": "^work-unit://[^\\s]+$"
    },
    "context_ref": {
      "type": "string",
      "pattern": "^context://[^\\s]+$"
    },
    "context_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "artifacts", "decisions", "assumptions"],
      "properties": {
        "files": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/path"}
        },
        "artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/ref"}
        },
        "decisions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "assumptions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "purpose"],
      "properties": {
        "paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/path"}
        },
        "purpose": {"type": "string", "minLength": 1}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions"],
      "properties": {
        "actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["read", "write", "execute-local", "delegate-recursive", "report"]}
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "kind": {"enum": ["test", "lint", "type", "schema", "reproducibility", "manual"]},
        "timeout_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
