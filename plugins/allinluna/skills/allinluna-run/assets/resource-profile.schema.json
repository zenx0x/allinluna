{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zenx0x/allinluna/schemas/resource-profile.schema.json",
  "title": "All in Luna Resource Profiles",
  "type": "object",
  "required": ["schema_version", "telemetry_policy", "profiles"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "telemetry_policy": { "type": "string", "minLength": 1 },
    "profiles": {
      "type": "object",
      "required": ["premium", "balanced", "economy", "speed", "all-luna", "mad-luna", "custom"],
      "additionalProperties": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "required": ["description", "hard_model_lock", "unavailable_action", "fallback_models", "concurrency", "budget", "roles"],
      "properties": {
        "description": { "type": "string" },
        "hard_model_lock": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["family", "match"],
              "properties": {
                "family": { "type": "string" },
                "match": { "enum": ["exact", "case-insensitive-substring"] }
              }
            }
          ]
        },
        "preferred_model_family": { "type": "string" },
        "unavailable_action": { "enum": ["pause", "ask", "fallback-list"] },
        "fallback_models": { "type": "array", "items": { "type": "string" } },
        "concurrency": {
          "type": "object",
          "required": ["desired", "strategy"],
          "properties": {
            "desired": { "type": "integer", "minimum": 1 },
            "strategy": { "enum": ["low-concurrency", "bounded-independent", "maximum-safe", "user-defined"] }
          }
        },
        "budget": {
          "type": "object",
          "required": ["metric", "soft_limit", "hard_limit", "on_soft_limit", "on_hard_limit"],
          "properties": {
            "metric": { "enum": ["none", "tokens", "credits", "time-minutes", "currency", "custom"] },
            "soft_limit": { "type": ["number", "null"], "minimum": 0 },
            "hard_limit": { "type": ["number", "null"], "minimum": 0 },
            "on_soft_limit": { "enum": ["reassess", "notify", "ignore"] },
            "on_hard_limit": { "const": "pause" }
          }
        },
        "roles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["model_request", "reasoning"],
            "properties": {
              "model_request": { "type": "string" },
              "reasoning": { "enum": ["low", "medium", "high", "xhigh", "max"] },
              "independent": { "type": "boolean" },
              "escalation_requires_approval": { "type": "boolean" },
              "duplicate_high_risk_review": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
