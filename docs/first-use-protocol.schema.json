{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zenx0x/allinluna/schemas/first-use-protocol.schema.json",
  "title": "All in Luna bounded first-use receipt",
  "type": "object",
  "required": ["protocol", "schema_version", "verification_mode", "identities", "capability_evidence", "events", "monitor", "integration_boundary"],
  "properties": {
    "protocol": { "const": "allinluna.first_use" },
    "schema_version": { "const": "1.0" },
    "verification_mode": { "enum": ["fixture", "real"] },
    "scenario": { "enum": ["success", "failure-recovery"] },
    "identities": {
      "type": "object",
      "required": ["sponsor", "coordinator", "owners", "host_id", "worktree", "repo"],
      "properties": {
        "sponsor": { "$ref": "#/$defs/identity" },
        "coordinator": { "$ref": "#/$defs/identity" },
        "owners": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/identity" } },
        "host_id": { "type": "string", "minLength": 1 },
        "worktree": { "type": "string", "minLength": 1 },
        "repo": { "type": "string", "minLength": 1 }
      }
    },
    "capability_evidence": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
    "events": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/event" } },
    "monitor": {
      "type": "object",
      "required": ["source", "cursor", "receipts"],
      "properties": { "cursor": { "type": "string", "minLength": 1 }, "receipts": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "source": { "enum": ["fixture", "codex_app"] } }
    },
    "integration_boundary": {
      "type": "object",
      "required": ["source", "boundary"],
      "properties": { "boundary": { "const": "mechanical-only" }, "source": { "enum": ["fixture", "codex_app"] }, "semantic_owner": { "type": "string" } }
    },
    "failures": { "type": "array", "items": { "$ref": "#/$defs/failure" } }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "required": ["thread_id", "role", "host_id", "worktree", "repo", "branch", "commit"],
      "properties": {
        "thread_id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["sponsor", "coordinator", "owner"] },
        "host_id": { "type": "string", "minLength": 1 },
        "worktree": { "type": "string", "minLength": 1 },
        "repo": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 }
      }
    },
    "capability": {
      "type": "object",
      "required": ["requested_tool", "resolved_tool", "actual_tool", "requested_capability", "resolved_capability", "actual_capability", "source"],
      "properties": {
        "requested_tool": { "type": "string" },
        "resolved_tool": { "type": "string" },
        "actual_tool": { "type": "string" },
        "requested_capability": { "type": "string" },
        "resolved_capability": { "type": "string" },
        "actual_capability": { "type": "string" },
        "source": { "enum": ["fixture", "codex_app"] }
      }
    },
    "event": {
      "type": "object",
      "required": ["seq", "event_id", "event", "identity"],
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "event_id": { "type": "string", "minLength": 1 },
        "event": { "enum": ["sponsor_started", "coordinator_created", "owner_dispatch_requested", "owner_thread_receipt", "owner_recovery", "repeated_tick", "owner_monitor_tick", "integration_boundary", "stop"] },
        "identity": { "$ref": "#/$defs/identity" },
        "tool_capability": { "$ref": "#/$defs/capability" },
        "idempotency": { "type": "object", "additionalProperties": { "enum": ["no-op", "reuse", "wait"] } },
        "receipt": { "$ref": "#/$defs/thread_receipt" }
      }
    },
    "thread_receipt": {
      "type": "object",
      "required": ["source", "actual_tool", "thread_id", "host_id", "worktree", "repo", "resource_receipt"],
      "properties": {
        "source": { "enum": ["fixture", "codex_app"] },
        "actual_tool": { "type": "string", "minLength": 1 },
        "thread_id": { "type": "string", "minLength": 1 },
        "client_thread_id": { "type": "string" },
        "host_id": { "type": "string", "minLength": 1 },
        "worktree": { "type": "string", "minLength": 1 },
        "repo": { "type": "string", "minLength": 1 },
        "status": { "type": "string" },
        "resource_receipt": { "$ref": "#/$defs/resource_receipt" },
        "failure_class": { "enum": ["product_failure", "host_tool_unavailable", "checker_error"] }
      }
    },
    "resource_values": {
      "type": "object",
      "required": ["model", "reasoning"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "reasoning": { "type": "string", "minLength": 1 }
      }
    },
    "resource_receipt": {
      "type": "object",
      "required": ["requested", "resolved", "actual", "actual_state", "evidence_source", "observed_at"],
      "properties": {
        "requested": { "$ref": "#/$defs/resource_values" },
        "resolved": { "$ref": "#/$defs/resource_values" },
        "actual": { "$ref": "#/$defs/resource_values" },
        "actual_state": { "const": "resolved" },
        "evidence_source": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    },
    "failure": {
      "type": "object",
      "required": ["class"],
      "properties": { "class": { "enum": ["product_failure", "host_tool_unavailable", "checker_error"] }, "message": { "type": "string" }, "recovered": { "type": "boolean" } }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["verification_mode"],
        "properties": { "verification_mode": { "const": "real" } }
      },
      "then": {
        "properties": {
          "capability_evidence": {
            "items": {
              "allOf": [
                { "$ref": "#/$defs/capability" },
                { "properties": { "source": { "const": "codex_app" }, "actual_tool": { "const": "codex_app__create_thread" } } }
              ]
            }
          },
          "monitor": { "properties": { "source": { "const": "codex_app" } } },
          "integration_boundary": { "properties": { "source": { "const": "codex_app" } } }
        }
      }
    }
  ]
}
