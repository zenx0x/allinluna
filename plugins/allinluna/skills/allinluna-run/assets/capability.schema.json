{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zenx0x/allinluna/schemas/capability.schema.json",
  "title": "All in Luna Capability Binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "purpose", "phase", "invocation_order", "host_requirement", "permission_scope", "expected_evidence", "fallback", "capability"],
  "properties": {
    "kind": {"enum": ["required", "applicable", "preferred", "optional"]},
    "purpose": {"type": "string"},
    "phase": {"type": "string"},
    "invocation_order": {"type": "integer", "minimum": 0},
    "host_requirement": {"type": ["string", "null"]},
    "permission_scope": {"type": "array", "items": {"type": "string"}},
    "expected_evidence": {"type": "array", "items": {"type": "string"}},
    "fallback": {"type": ["string", "object", "null"]},
    "capability": {"$ref": "#/$defs/capability"},
    "tool_schema": {"$ref": "#/$defs/tool_schema"},
    "fallback_evidence": {"$ref": "#/$defs/evidence"},
    "runtime_catalog": {"$ref": "#/$defs/runtime_catalog"},
    "receipt_evidence": {"$ref": "#/$defs/receipt_evidence"}
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["skill", "mcp", "app", "script", "plugin"]},
        "plugin_type": {"enum": ["skill", "mcp", "app", "script"]},
        "version": {"type": ["string", "null"]},
        "available": {"type": "boolean"},
        "discovery_evidence": {"type": ["string", "object", "array", "boolean", "null"]}
      }
    },
    "tool_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "parameters"],
      "properties": {
        "tool": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"},
        "receipt": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "resolved", "actual", "fallback"],
      "properties": {
        "requested": {},
        "resolved": {},
        "actual": {},
        "fallback": {"type": ["string", "null"]}
      }
    },
    "receipt_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "actual_tool", "output_dir", "capability"],
      "properties": {
        "source": {"const": "codex_app"},
        "actual_tool": {"type": "string", "minLength": 1},
        "output_dir": {"type": ["string", "null"]},
        "capability": {"$ref": "#/$defs/evidence"},
        "capability_evidence": {"$ref": "#/$defs/evidence"},
        "runtime_evidence": {"$ref": "#/$defs/runtime_evidence"}
      }
    },
    "runtime_evidence": {
      "type": "object",
      "required": ["source", "actual_tool", "requested", "resolved", "actual", "fallback"],
      "properties": {
        "source": {"const": "codex_app"},
        "actual_tool": {"type": "string", "minLength": 1},
        "requested": {},
        "resolved": {},
        "actual": {},
        "fallback": {"type": ["string", "null"]},
        "capability": {"$ref": "#/$defs/evidence"}
      }
    },
    "receipt_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "actual_tool", "required", "capability"],
      "properties": {
        "source": {"const": "codex_app"},
        "actual_tool": {"type": "string", "minLength": 1},
        "required": {"type": "array", "items": {"type": "string"}},
        "capability": {"type": "array", "items": {"type": "string"}},
        "fallback_when_missing": {"type": "string", "minLength": 1}
      }
    },
    "runtime_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "tool_catalog", "fallbacks"],
      "properties": {
        "schema_version": {"type": "string"},
        "catalog_id": {"type": "string"},
        "capability_receipt": {"type": "object"},
        "thread_tools": {"type": "array", "items": {"type": "string"}},
        "tool_catalog": {"type": "object"},
        "fallbacks": {"type": "object"},
        "receipt_protocol": {"$ref": "#/$defs/receipt_protocol"}
      }
    }
  }
}
