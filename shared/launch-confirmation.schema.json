{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zenx0x/allinluna/schemas/launch-confirmation.schema.json",
  "title": "All in Luna Launch Confirmation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "confirmation_id", "status", "intake_id", "plan_source", "adjustment_permission", "work_type", "profile", "model", "reasoning", "concurrency", "coordinator", "risk_level", "counterpilot", "counterpilot_question", "questions", "goal", "git", "external_mutation", "toolchain", "budget", "decomposition_review", "confirmation_prompt"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "confirmation_id": {"type": "string", "minLength": 3},
    "created_at": {"type": "string"},
    "status": {"enum": ["pending", "confirmed"]},
    "intake_id": {"type": ["string", "null"]},
    "plan_source": {"type": "string"},
    "adjustment_permission": {"enum": ["ask", "allowed", "forbidden"]},
    "work_type": {"type": "string"},
    "profile": {"type": "string"},
    "model": {"type": "string"},
    "reasoning": {"type": "string"},
    "concurrency": {"type": "integer", "minimum": 1, "maximum": 64},
    "coordinator": {"type": "string"},
    "risk_level": {"enum": ["unknown", "low", "medium", "high", "critical"]},
    "counterpilot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "risk_waiver"],
      "properties": {
        "mode": {"enum": ["off", "auto", "risk-triggered", "milestone", "continuous"]},
        "risk_waiver": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["acknowledged", "reason"],
          "properties": {
            "acknowledged": {"const": true},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "counterpilot_question": {"$ref": "#/$defs/counterpilotQuestion"},
    "questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/counterpilotQuestion"}},
    "goal": {"type": "string"},
    "git": {"type": "object"},
    "external_mutation": {"type": "string"},
    "toolchain": {"type": "string"},
    "budget": {"type": "string"},
    "decomposition_review": {"enum": ["not-required", "accepted", "declined"]},
    "confirmation_prompt": {"type": "string", "minLength": 20}
  },
  "$defs": {
    "counterpilotQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "options", "answer", "risk_waiver_required", "risk_waiver"],
      "properties": {
        "id": {"const": "counterpilot.mode"},
        "prompt": {"type": "string", "minLength": 1},
        "options": {
          "type": "array",
          "const": ["off", "auto", "risk-triggered", "milestone", "continuous"]
        },
        "answer": {"enum": ["off", "auto", "risk-triggered", "milestone", "continuous"]},
        "risk_waiver_required": {"type": "boolean"},
        "risk_waiver": {"$ref": "#/properties/counterpilot/properties/risk_waiver"}
      }
    }
  }
}
