      "plugins/allinluna/skills/allinluna-run/assets/runtime-catalog.example.json"
    ],
    "recovery": [
      "plugins/allinluna/skills/allinluna-run/references/recovery.md",
      "plugins/allinluna/skills/allinluna-run/scripts/control_run.py",
      "plugins/allinluna/skills/allinluna-run/scripts/reconcile_threads.py"
