{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zenx0x/allinluna/schemas/run-state.schema.json",
  "title": "All in Luna Run State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "plan_id",
    "plan_hash",
    "run_dir",
    "status",
    "profile",
    "goal_authorized",
    "capabilities",
    "resource_policy",
    "usage",
    "repository",
    "authorizations",
    "orchestration",
    "coordination",
    "defects",
    "completion_standard",
    "tasks",
    "milestones",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "plan_id": { "type": "string", "minLength": 1 },
    "plan_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "run_dir": { "type": "string", "minLength": 1 },
    "status": { "enum": ["planned", "running", "paused", "blocked", "completed", "failed"] },
    "profile": { "enum": ["premium", "balanced", "economy", "speed", "all-luna", "mad-luna", "custom"] },
    "goal_authorized": { "type": "boolean" },
    "capabilities": {
      "type": "object",
      "required": ["requested_delegation", "actual_delegation", "host_concurrency", "fallback_reason"],
      "properties": {
        "requested_delegation": { "enum": ["auto", "top-level-task", "subagent", "sequential"] },
        "actual_delegation": { "enum": ["unavailable", "top-level-task", "subagent", "sequential"] },
        "host_concurrency": { "type": ["integer", "string"] },
        "fallback_reason": { "type": ["string", "null"] }
      }
    },
    "resource_policy": { "type": "object" },
    "usage": {
      "type": "object",
      "required": ["tokens", "credits", "elapsed_seconds", "currency"],
      "properties": {
        "tokens": { "type": ["integer", "string"] },
        "credits": { "type": ["number", "string"] },
        "elapsed_seconds": { "type": ["number", "string"] },
        "currency": { "type": ["number", "string"] }
      }
    },
    "repository": { "type": "object" },
    "authorizations": { "type": "object" },
    "orchestration": {
      "type": "object",
      "required": ["root_role", "root_product_implementation", "owner_delegation", "owner_subagents"],
      "properties": {
        "root_role": { "const": "coordinator" },
        "root_product_implementation": { "const": "forbidden" },
        "owner_delegation": { "const": "top-level-task" },
        "owner_subagents": { "const": "allowed-bounded" }
      }
    },
    "coordination": {
      "type": "object",
      "required": ["plan_revision", "last_tick_at", "stop_boundary"],
      "properties": {
        "plan_revision": { "type": "integer", "minimum": 0 },
        "last_tick_at": { "type": ["string", "null"] },
        "stop_boundary": { "type": ["string", "null"] }
      }
    },
    "defects": { "type": "object" },
    "completion_standard": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "tasks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/taskState" }
    },
    "milestones": { "type": "array" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "taskState": {
      "type": "object",
      "required": [
        "id",
        "title",
        "description",
        "phase",
        "role",
        "resource_class",
        "status",
        "dependencies",
        "ownership",
        "external_side_effects",
        "acceptance_required",
        "deliverables",
        "verification",
        "validation_level",
        "requested",
        "actual",
        "assignment",
        "evidence",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "phase": { "type": "string" },
        "role": { "type": "string" },
        "resource_class": { "type": "string" },
        "status": { "enum": ["pending", "ready", "running", "blocked", "failed", "completed", "skipped", "cancelled"] },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "ownership": { "type": "object" },
        "external_side_effects": { "type": "array" },
        "acceptance_required": { "type": "boolean" },
        "deliverables": { "type": "array", "items": { "type": "string" } },
        "verification": { "type": "array", "items": { "type": "string" } },
        "validation_level": { "enum": ["focused", "cross-lane", "milestone", "full"] },
        "requested": { "$ref": "#/$defs/assignmentRequest" },
        "actual": { "$ref": "#/$defs/assignmentActual" },
        "assignment": { "type": "object" },
        "evidence": { "type": "object" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "assignmentRequest": {
      "type": "object",
      "required": ["role", "model", "reasoning", "delegation"],
      "properties": {
        "role": { "type": "string" },
        "model": { "type": "string" },
        "reasoning": { "type": "string" },
        "delegation": { "type": "string" }
      }
    },
    "assignmentActual": {
      "type": "object",
      "required": ["model", "reasoning", "delegation", "resolution"],
      "properties": {
        "model": { "type": "string" },
        "reasoning": { "type": "string" },
        "delegation": { "type": "string" },
        "resolution": { "type": "string" }
      }
    }
  }
}
