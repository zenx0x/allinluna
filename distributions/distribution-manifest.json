    "schema": [
      "plugins/allinluna/skills/allinluna-plan/assets/development-plan.schema.json",
      "plugins/allinluna/skills/allinluna-run/assets/resource-profile.schema.json",
      "plugins/allinluna/skills/allinluna-run/assets/run-state.schema.json"
    ],
    "control_plane": [
